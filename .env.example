# Required
EXTEND_API_KEY=your_api_key_here

# Optional - API Config
EXTEND_API_VERSION=2026-02-09
EXTEND_BASE_URL=https://api.us2.extend.app

# Optional - Tool Enablement (default: all true)
EXTEND_ENABLE_PROCESSORS=true
EXTEND_ENABLE_WORKFLOWS=true
EXTEND_ENABLE_PARSE=true
EXTEND_ENABLE_EXTRACTORS=true
